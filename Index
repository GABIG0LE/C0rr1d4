}
function drawWinner(u, now){
  ctx.fillStyle="rgba(11,13,20,.8)"; ctx.fillRect(0,0,W,H);
  ctx.textAlign="center"; ctx.textBaseline="middle";
  const w = race.winner;
  const col = w==="EMPATE" ? "#ffc83d" : colorOf(w);
  ctx.font = F(800, Math.max(16,u*3)); ctx.fillStyle="#8b93ad";
  ctx.fillText(w==="EMPATE" ? "RESULTADO" : "VENCEDOR", W/2, H*0.24);
  const pulse = 1 + Math.sin(now/220)*0.03;
  ctx.save(); ctx.translate(W/2, H*0.38); ctx.scale(pulse,pulse);
  ctx.font = FD(Math.max(56,u*22)); ctx.fillStyle = col; ctx.fillText(w, 0, 0, W*0.9); ctx.restore();
  const d = Math.abs(race.runners["13"].dist - race.runners["22"].dist);
  ctx.font = F(800, Math.max(16,u*3)); ctx.fillStyle="#eef1fa";
  ctx.fillText(`${Math.round(race.runners["13"].dist)} m  x  ${Math.round(race.runners["22"].dist)} m   ·   diferença de ${Math.round(d)} m`, W/2, H*0.53, W*0.92);
  ctx.font = F(600, Math.max(13,u*2.2)); ctx.fillStyle="#8b93ad";
  ctx.fillText(`${race.changes} trocas de liderança`, W/2, H*0.6);
  ["13","22"].forEach((team, i) => {
    let mvp=null, best=0; race.coins[team].forEach((c,n)=>{ if(c>best){best=c; mvp=n;} });
    ctx.fillStyle = colorOf(team); ctx.font = F(800, Math.max(14,u*2.4));
    ctx.fillText(`MVP do ${team}: ${mvp ? "@"+mvp+" ("+best+" moedas)" : "ninguém"}`, W/2, H*0.68 + i*Math.max(26,u*4), W*0.92);
  });
  if(cfg.auto){
    const s = Math.max(0, Math.ceil((nextRaceAt - performance.now())/1000));
    ctx.font = F(700, Math.max(14,u*2.4)); ctx.fillStyle="#ffc83d";
    ctx.fillText(`Nova corrida em ${s} s  ·  comente 13 ou 22 para entrar`, W/2, H*0.84, W*0.92);
  } else {
    ctx.font = F(700, Math.max(14,u*2.4)); ctx.fillStyle="#eef1fa";
    ctx.fillText("Toque para nova corrida", W/2, H*0.84);
  }
}

/* ===================== Som ===================== */
let actx = null;
function audio(){ if(!actx){ try{ actx = new (window.AudioContext||window.webkitAudioContext)(); }catch(e){} } if(actx && actx.state==="suspended") actx.resume(); return actx; }
function tone(freq, dur, type, vol, slide){
  const a = actx; if(!a || !cfg.sound) return;
  const o = a.createOscillator(), g = a.createGain();
  o.type = type||"square"; o.frequency.setValueAtTime(freq, a.currentTime);
  if(slide) o.frequency.exponentialRampToValueAtTime(slide, a.currentTime+dur);
  g.gain.setValueAtTime(vol||0.08, a.currentTime); g.gain.exponentialRampToValueAtTime(0.0001, a.currentTime+dur);
  o.connect(g).connect(a.destination); o.start(); o.stop(a.currentTime+dur);
}
let lastSfx = 0;
function sfx(k){
  if(!actx || !cfg.sound) return;
  const n = performance.now(); if((k==="boost"||k==="tired") && n-lastSfx<90) return; lastSfx = n;
  if(k==="tick") tone(660,0.12,"square",0.08);
  if(k==="go") tone(990,0.35,"square",0.1);
  if(k==="boost") tone(300,0.25,"sawtooth",0.05,900);
  if(k==="tired") tone(500,0.3,"triangle",0.07,160);
  if(k==="overtake"){ tone(660,0.12,"square",0.08); setTimeout(()=>tone(990,0.2,"square",0.08),110); }
  if(k==="gold"){ tone(880,0.15,"triangle",0.09); setTimeout(()=>tone(1320,0.25,"triangle",0.09),130); }
  if(k==="win"){ [523,659,784,1046].forEach((f,i)=>setTimeout(()=>tone(f,0.3,"square",0.08),i*150)); }
}

