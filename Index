let ws = null, wantConn = false, reconnectTimer = null, lastMsgAt = 0;
const statusEl = document.getElementById("connStatus");
function setStatus(txt, on){ statusEl.textContent = txt; statusEl.className = "status " + (on?"on":"off"); }
function connect(){
  clearTimeout(reconnectTimer);
  const user = String(cfg.user||"").replace(/^@/,"").trim(), key = String(cfg.key||"").trim();
  if(!user || !key){ setStatus("Preencha o @ e a chave", false); return; }
  wantConn = true;
  try { if(ws) ws.close(); } catch(e) {}
  setStatus("Conectando…", false);
  let sock;
  try {
    sock = new WebSocket(`wss://ws.eulerstream.com?uniqueId=${encodeURIComponent(user)}&apiKey=${encodeURIComponent(key)}`);
  } catch(e) {
    setStatus("Conexão bloqueada neste navegador", false);
    logLine("Erro ao abrir conexão: " + e.message + ". Nesta prévia do Claude a conexão é bloqueada; use o arquivo hospedado.");
    return;
  }
  ws = sock;
  sock.onopen = () => { setStatus("Conectado a @"+user, true); logLine("Conectado. Aguardando eventos da live…"); };
  sock.onmessage = ev => { lastMsgAt = Date.now(); try { route(JSON.parse(ev.data)); } catch(e){ logLine("Mensagem não lida: " + String(ev.data).slice(0,120)); } };
  sock.onerror = () => { logLine("Erro de conexão. Confira o @, a chave e se a live está aberta. Nesta prévia do Claude a conexão é bloqueada; use o arquivo hospedado."); };
  sock.onclose = ev => {
    if(ws !== sock) return;
    setStatus(`Desconectado${ev.reason ? " ("+ev.reason.slice(0,40)+")" : ""}`, false);
    logLine(`Conexão encerrada (código ${ev.code}${ev.reason?": "+ev.reason:""}).`);
    if(wantConn) reconnectTimer = setTimeout(connect, 5000);
  };
}
function disconnect(){ wantConn = false; clearTimeout(reconnectTimer); try{ if(ws) ws.close(); }catch(e){} ws=null; setStatus("Desconectado", false); }

const seenTypes = new Set();
function route(payload){
  let list = [];
  if(Array.isArray(payload)) list = payload;
  else if(payload && Array.isArray(payload.messages)) list = payload.messages;
  else if(payload && Array.isArray(payload.events)) list = payload.events;
  else list = [payload];
  list.forEach(m => {
    if(!m || typeof m !== "object") return;
    const type = String(m.type || m.method || m.event || m.eventType || "");
    const data = m.data || m.payload || m;
    if(!seenTypes.has(type)){ seenTypes.add(type); logLine(`novo tipo de evento: ${type || "(sem tipo)"}`); }
    const user = data.user || data.userInfo || data.sender || {};
    const uid = String(user.uniqueId || user.unique_id || user.displayId || user.userId || user.id || data.uniqueId || data.userId || "anon");
    const nick = String(user.nickname || user.nickName || user.uniqueId || data.nickname || uid);
    if(/chat|comment|social.?message/i.test(type) && !/gift/i.test(type)){
      const text = data.comment ?? data.content ?? data.text ?? data.message ?? "";
      if(text) handleComment(uid, nick, text);
    } else if(/gift/i.test(type)){
      const g = data.gift || data.giftDetails || {};
      const name = g.name || g.giftName || data.giftName || data.giftDetails?.giftName || "presente";
      const diamonds = +(g.diamondCount ?? g.diamond_count ?? data.diamondCount ?? data.giftDetails?.diamondCount ?? 1) || 1;
      const gtRaw = data.giftType ?? g.type ?? g.giftType ?? data.giftDetails?.giftType;
      const giftType = +(gtRaw ?? 0);
      const repeat = +(data.repeatCount ?? g.repeatCount ?? data.comboCount ?? data.repeat_count ?? 1) || 1;
      const repeatEnd = !!(data.repeatEnd ?? data.repeat_end ?? false);
      const key = uid + "|" + name;
      const prev = streaks.get(key) || 0;
      let delta = repeat > prev ? repeat - prev : repeat;
      if(repeatEnd && repeat === prev) delta = 0; // fim de combo já contado
      const nonStreak = gtRaw !== undefined && giftType !== 1;
      if(repeatEnd || nonStreak) streaks.delete(key); else streaks.set(key, repeat);
      handleGift(uid, nick, name, delta, diamonds);
    }
  });
}

/* ===================== Interface ===================== */
const $ = id => document.getElementById(id);
const panel = $("panel"), gear = $("gear");
function syncColors(){ document.documentElement.style.setProperty("--c13", colorOf("13")); document.documentElement.style.setProperty("--c22", colorOf("22")); }
syncColors();
function fill(){
  $("cfgDur").value = cfg.dur; $("cfgGap").value = cfg.gap; $("cfgAuto").checked = !!cfg.auto;
  $("cfgUser").value = cfg.user; $("cfgKey").value = cfg.key;
  ["g_imp","g_can","g_simp","g_scan"].forEach(k => $(k).value = cfg[k]);
  $("cfgOther").checked = !!cfg.other;
  $("col13").value = cfg.col13; $("col22").value = cfg.col22;
  $("btnSound").textContent = "Som: " + (cfg.sound ? "ligado" : "desligado");
}
fill();
const bind = (id, key, fn) => $(id).addEventListener("input", e => { const el=e.target; cfg[key] = el.type==="checkbox" ? el.checked : el.type==="number" ? +el.value : el.value; save(); fn && fn(); });
bind("cfgDur","dur"); bind("cfgGap","gap"); bind("cfgAuto","auto"); bind("cfgUser","user"); bind("cfgKey","key");
["g_imp","g_can","g_simp","g_scan"].forEach(k => bind(k,k)); bind("cfgOther","other");
bind("col13","col13",syncColors); bind("col22","col22",syncColors);
$("cfgAuto").addEventListener("change", e => { cfg.auto = e.target.checked; save(); });
$("cfgOther").addEventListener("change", e => { cfg.other = e.target.checked; save(); });

function openPanel(){ panel.hidden = false; }
function closePanel(){ panel.hidden = true; }
gear.addEventListener("click", () => { audio(); panel.hidden ? openPanel() : closePanel(); });
$("closePanel").addEventListener("click", closePanel);
$("btnStart").addEventListener("click", () => { audio(); startRace(); closePanel(); });
$("btnSound").addEventListener("click", () => { cfg.sound = !cfg.sound; save(); fill(); audio(); });
$("btnConnect").addEventListener("click", () => { audio(); connect(); });
$("btnDisconnect").addEventListener("click", disconnect);
cv.addEventListener("click", () => { audio(); if(phase==="idle" || (phase==="end" && !cfg.auto)) startRace(); });

function readImg(input, team){
  const f = input.files && input.files[0]; if(!f) return;
  const rd = new FileReader();
  rd.onload = () => {
    const im = new Image();
    im.onload = () => {
      const max = 360, s = Math.min(1, max/Math.max(im.width, im.height));
      const c = document.createElement("canvas"); c.width = Math.round(im.width*s); c.height = Math.round(im.height*s);
      c.getContext("2d").drawImage(im, 0, 0, c.width, c.height);
      cfg["img"+team] = c.toDataURL("image/png"); save(); loadImg(team);
      logLine(`Imagem do ${team} carregada.`);
    };
    im.src = rd.result;
  };
  rd.readAsDataURL(f);
}
$("img13").addEventListener("change", e => readImg(e.target, 13));
$("img22").addEventListener("change", e => readImg(e.target, 22));
$("btnClearImg").addEventListener("click", () => { cfg.img13=""; cfg.img22=""; save(); loadImg(13); loadImg(22); });

// botões de teste
const simgrid = $("simgrid");
const simActs = [["com","Comentário"],["imp","Impulso"],["can","Cansaço no rival"],["simp","Super impulso"],["scan","Super cansaço"]];
let simN = 0;
simActs.forEach(([k,label]) => TEAMS.forEach(team => {
  const b = document.createElement("button"); b.className = "b t"+team; b.textContent = label;
  b.addEventListener("click", () => { audio(); simulate(k, team, "teste"+team+"_"+(k==="com"?"":(simN++%3))); });
  simgrid.appendChild(b);
}));
function simulate(k, team, uid){
  if(phase!=="run"){ logLine("Inicie uma corrida para testar os efeitos."); }
  if(k==="com") { handleComment(uid, uid, team); return; }
  if(!viewers.has(uid)) handleComment(uid, uid, team);
  const name = String(cfg["g_"+k]||"").split(",")[0].trim() || "Rose";
  handleGift(uid, uid, name, 1, k==="simp"||k==="scan" ? 30 : 1);
}
let crowdTimer = null;
$("simCrowd").addEventListener("change", e => {
  clearInterval(crowdTimer);
  if(e.target.checked) crowdTimer = setInterval(() => {
    if(phase!=="run") return;
    const team = Math.random() < 0.5 ? "13" : "22";
    const uid = "fã" + team + "_" + (Math.random()*25|0);
    const roll = Math.random();
    if(roll < 0.86) handleComment(uid, uid, team);
    else {
      if(!viewers.has(uid)) handleComment(uid, uid, team);
      const ks = ["imp","imp","can","can","simp","scan"]; const k = ks[Math.random()*ks.length|0];
      const name = String(cfg["g_"+k]||"").split(",")[0].trim();
      handleGift(uid, uid, name, 1 + (Math.random()<0.2 ? (Math.random()*4|0) : 0), k==="simp"||k==="scan"?30:1);
    }
  }, 260);
});

const logEl = $("log"); const logBuf = [];
function logLine(s){
  const d = new Date(); const ts = d.toTimeString().slice(0,8);
  logBuf.unshift(`${ts}  ${s}`); if(logBuf.length > 60) logBuf.pop();
  if(!panel.hidden) logEl.textContent = logBuf.join("\n");
}
const obs = new MutationObserver(() => { if(!panel.hidden) logEl.textContent = logBuf.join("\n"); });
obs.observe(panel, {attributes:true, attributeFilter:["hidden"]});

// manter a tela acesa
let wake = null;
async function keepAwake(){ try{ if("wakeLock" in navigator && document.visibilityState==="visible") wake = await navigator.wakeLock.request("screen"); }catch(e){} }
document.addEventListener("visibilitychange", keepAwake); keepAwake();

// engrenagem some quando parada
let idleT = 0;
["pointermove","pointerdown"].forEach(ev => window.addEventListener(ev, () => { gear.style.opacity = ""; idleT = performance.now(); }));

/* ===================== Loop ===================== */
let last = performance.now();
function loop(now){
  const dt = Math.min(0.1, (now - last)/1000); last = now;
  update(dt);
  draw(now, Math.min(0.05, dt || 1/60));
  if(now - idleT > 4000 && panel.hidden) gear.style.opacity = "0.12";
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);

// exposto para testes
window.__corrida = {get race(){return race;}, get phase(){return phase;}, startRace, update, handleComment, handleGift, route, setPhase(p){phase=p;}};
})();
</script>

