<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
</head>
<body>
<title>Corrida 13 x 22</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bungee&family=Barlow+Semi+Condensed:wght@500;600;700;800&display=swap">
<style>
/* Layout: tela única de arcade noturno. Canvas cheio com HUD desenhado; painel de ajustes desliza por cima. Tema escuro único, por escolha. */
:root{
  --bg:#0b0d14; --panel:#141826; --line:#272d42; --fg:#eef1fa; --muted:#8b93ad;
  --gold:#ffc83d; --ok:#3ddc84; --bad:#ff5a5a;
  --display:"Bungee","Impact","Arial Black",sans-serif;
  --body:"Barlow Semi Condensed","Arial Narrow","Helvetica Neue",Arial,sans-serif;
  color-scheme:dark;
}
[hidden]{display:none!important;}
html,body{height:100%;}
body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--body);overflow:hidden;-webkit-user-select:none;user-select:none;touch-action:manipulation;}
#game{position:fixed;inset:0;width:100%;height:100%;display:block;}
#gear{position:fixed;top:calc(env(safe-area-inset-top,0px) + 10px);right:12px;z-index:5;width:40px;height:40px;border-radius:50%;
  border:1px solid var(--line);background:rgba(20,24,38,.7);color:var(--fg);font:700 18px var(--body);cursor:pointer;opacity:.35;transition:opacity .3s;}
#gear:hover,#gear:focus-visible{opacity:1;outline:2px solid var(--gold);}
#panel{position:fixed;top:0;right:0;bottom:0;z-index:10;width:min(440px,100%);background:var(--panel);border-left:1px solid var(--line);
  overflow-y:auto;-webkit-overflow-scrolling:touch;padding:calc(env(safe-area-inset-top,0px) + 16px) 16px calc(env(safe-area-inset-bottom,0px) + 24px);
  box-sizing:border-box;-webkit-user-select:text;user-select:text;display:flex;flex-direction:column;gap:18px;}
#panel h2{font:400 20px var(--display);margin:0;letter-spacing:.02em;}
#panel h3{font:800 13px var(--body);text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin:0 0 8px;}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center;}
.row > *{min-width:0;}
.sec{display:flex;flex-direction:column;gap:8px;border-top:1px solid var(--line);padding-top:14px;}
label{font:600 14px var(--body);color:var(--muted);display:flex;flex-direction:column;gap:4px;flex:1 1 140px;}
input[type=text],input[type=password],input[type=number]{background:var(--bg);color:var(--fg);border:1px solid var(--line);border-radius:8px;
  padding:9px 10px;font:600 16px var(--body);width:100%;box-sizing:border-box;}
input:focus-visible,button:focus-visible{outline:2px solid var(--gold);outline-offset:1px;}
button.b{background:#222840;color:var(--fg);border:1px solid var(--line);border-radius:8px;padding:9px 12px;font:700 15px var(--body);cursor:pointer;}
button.b:active{transform:translateY(1px);}
button.primary{background:var(--gold);color:#1a1300;border-color:var(--gold);}
button.t13{border-color:var(--c13,#e5322d);}
button.t22{border-color:var(--c22,#2563eb);}
.check{flex-direction:row;align-items:center;gap:8px;color:var(--fg);flex:1 1 100%;}
.status{font:700 14px var(--body);padding:6px 10px;border-radius:999px;background:var(--bg);border:1px solid var(--line);}
.status.on{color:var(--ok);border-color:var(--ok);} .status.off{color:var(--bad);border-color:var(--bad);}
.note{font:500 14px/1.4 var(--body);color:var(--muted);margin:0;}
#log{background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:8px;font:500 12px/1.45 ui-monospace,Menlo,monospace;
  max-height:180px;overflow:auto;white-space:pre-wrap;word-break:break-word;color:var(--muted);}
.simgrid{display:grid;grid-template-columns:1fr 1fr;gap:6px;}
.simgrid .hd{font:400 16px var(--display);text-align:center;}
@media (prefers-reduced-motion:reduce){#gear{transition:none;}}
</style>

<canvas id="game" aria-label="Corrida ao vivo entre os corredores 13 e 22"></canvas>
<button id="gear" aria-label="Abrir ajustes">⚙</button>

<aside id="panel" hidden aria-label="Ajustes da corrida">
  <div class="row" style="justify-content:space-between">
    <h2>Ajustes</h2>
    <button class="b" id="closePanel">Fechar</button>
  </div>

  <div class="sec">
    <h3>Corrida</h3>
    <div class="row">
      <button class="b primary" id="btnStart">Iniciar nova corrida</button>
      <button class="b" id="btnSound">Som: ligado</button>
    </div>
    <div class="row">
      <label>Duração (min)<input type="number" id="cfgDur" min="1" max="20" step="0.5"></label>
      <label>Intervalo entre corridas (s)<input type="number" id="cfgGap" min="5" max="120" step="1"></label>
    </div>
    <label class="check"><input type="checkbox" id="cfgAuto"> Reiniciar sozinho após cada corrida</label>
  </div>

  <div class="sec">
    <h3>Conexão com a live</h3>
    <div class="row">
      <label>Seu @ do TikTok (sem @)<input type="text" id="cfgUser" autocomplete="off" autocapitalize="off" spellcheck="false"></label>
    </div>
    <div class="row">
      <label>Chave da Euler Stream<input type="password" id="cfgKey" autocomplete="off" spellcheck="false"></label>
    </div>
    <div class="row">
      <button class="b primary" id="btnConnect">Conectar</button>
      <button class="b" id="btnDisconnect">Desconectar</button>
      <span class="status off" id="connStatus">Desconectado</span>
    </div>
    <p class="note">Inicie a live antes de conectar. Se a conexão cair, o jogo tenta reconectar a cada 5 segundos.</p>
  </div>

  <div class="sec">
    <h3>Presentes (nome em inglês, como aparece no registro abaixo)</h3>
    <div class="row">
      <label>Impulso<input type="text" id="g_imp"></label>
      <label>Cansaço no rival<input type="text" id="g_can"></label>
    </div>
    <div class="row">
      <label>Super impulso<input type="text" id="g_simp"></label>
      <label>Super cansaço no rival<input type="text" id="g_scan"></label>
    </div>
    <p class="note">Vários nomes no mesmo campo: separe por vírgula.</p>
    <label class="check"><input type="checkbox" id="cfgOther"> Outros presentes dão impulso</label>
  </div>

  <div class="sec">
    <h3>Personagens</h3>
    <p class="note">Envie PNG sem fundo, virado para a direita.</p>
    <div class="row">
      <label>Imagem do 13<input type="file" id="img13" accept="image/*"></label>
      <label>Imagem do 22<input type="file" id="img22" accept="image/*"></label>
    </div>
    <div class="row">
      <label>Cor do 13<input type="text" id="col13" placeholder="#e5322d"></label>
      <label>Cor do 22<input type="text" id="col22" placeholder="#2563eb"></label>
    </div>
    <button class="b" id="btnClearImg">Voltar aos personagens padrão</button>
  </div>

  <div class="sec">
    <h3>Modo de teste</h3>
    <div class="simgrid" id="simgrid">
      <div class="hd" style="color:var(--c13)">13</div><div class="hd" style="color:var(--c22)">22</div>
    </div>
    <label class="check"><input type="checkbox" id="simCrowd"> Simular público (comentários e presentes aleatórios)</label>
  </div>

  <div class="sec">
    <h3>Registro de eventos</h3>
    <div id="log" aria-live="polite"></div>
  </div>
</aside>

<script>
(() => {
"use strict";

/* ===================== Balanceamento ===================== */
const BASE = 30, VMIN = 6, VMAX = 90, ACCEL = 45; // km/h, km/h por segundo
const EFFECTS = {
  imp:  {label:"IMPULSO",        dv: 20, dur: 5,  self:true},
  can:  {label:"CANSAÇO",        dv:-15, dur: 7,  self:false},
  simp: {label:"SUPER IMPULSO",  dv: 45, dur: 8,  self:true},
  scan: {label:"SUPER CANSAÇO",  dv:-24, dur: 15, self:false}
};
const COMMENT = {dv:1, dur:4, cooldown:3, cap:12};
const GOLD = {mult:1.5, len:15, slots:[[40,80],[120,160],[195,235]]};
const FINAL = {mult:2, len:30};
const OVERTIME = 15, TIE = 5;

/* ===================== Ajustes salvos ===================== */
const DEF = {dur:5, gap:15, auto:true, sound:true, user:"", key:"",
  g_imp:"Rose", g_can:"TikTok", g_simp:"Doughnut", g_scan:"Perfume", other:true,
  col13:"#e5322d", col22:"#2563eb", img13:"", img22:""};
let cfg = Object.assign({}, DEF);
try { const s = JSON.parse(localStorage.getItem("corrida1322") || "{}"); Object.assign(cfg, s); } catch(e) {}
function save(){ try { localStorage.setItem("corrida1322", JSON.stringify(cfg)); } catch(e) {} }

/* ===================== Estado ===================== */
const TEAMS = ["13","22"];
const imgs = {13:null, 22:null};
/* Sprites embutidos: tiras de 5 frames por estado (normal, turbo, tired), alinhadas pelos pés */
const SPRITES = {"13": {"normal": {"src": "data:image/png;base64,", "frames": 5, "ax": 0.4826576895847689, "ay": 0.9974916875692702, "bodyH": 0.9216589861751152}, "tired": {"src": "data:image/png;base64,", "frames": 5, "ax": 0.4826576895847689, "ay": 0.9974916875692702, "bodyH": 0.9216589861751152}, "turbo": {"src": "data:image/png;base64,", "frames": 5, "ax": 0.4826576895847689, "ay": 0.9974916875692702, "bodyH": 0.9216589861751152}}, "22": {"normal": {"src": "data:image/png;base64,", "frames": 5, "ax": 0.48634664727868226, "ay": 0.9867452135493372, "bodyH": 0.8928571428571429}, "turbo": {"src": "data:image/png;base64,", "frames": 5, "ax": 0.48634664727868226, "ay": 0.9867452135493372, "bodyH": 0.8928571428571429}, "tired": {"src": "data:image/png;base64,", "frames": 5, "ax": 0.48634664727868226, "ay": 0.9867452135493372, "bodyH": 0.8928571428571429}}};
const sprites = {13:null, 22:null};
(function(){ for(const t of ["13","22"]){ const d = SPRITES[t]; if(!d) continue; sprites[t] = {}; for(const st in d){ const meta = d[st]; const im = new Image(); im.onload = () => { sprites[t][st] = Object.assign({im, fw:im.width/meta.frames, fh:im.height}, meta); }; im.src = meta.src; } } })();
function loadImg(team){
  const src = cfg["img"+team];
  if(!src){ imgs[team]=null; return; }
  const im = new Image(); im.onload = () => { imgs[team]=im; }; im.src = src;
}
loadImg(13); loadImg(22);

let race;
const viewers = new Map(); // uid -> {team, nick, lastBoost}
const pending = new Map(); // uid -> [{kind,count,coins}]
const streaks = new Map();
let feed = [], banners = [], particles = [];
let phase = "idle"; // idle | countdown | run | end
let phaseT = 0, countdownLeft = 0, nextRaceAt = 0;

function newRunner(team){ return {team, dist:0, v:BASE, fx:{}, comments:[], phaseLeg:Math.random()*6, bob:0}; }
function resetRace(){
  const dur = Math.max(1, +cfg.dur || 5) * 60;
  const golds = GOLD.slots
    .map(([a,b]) => a + Math.random()*(b-a))
    .map(s => s * dur/300)
    .filter(s => s + GOLD.len < dur - FINAL.len);
  race = {t:0, dur, end:dur, overtime:false, runners:{13:newRunner("13"), 22:newRunner("22")},
    leader:null, changes:0, partials:[], golds, coins:{13:new Map(), 22:new Map()},
    lastGifter:{13:null, 22:null}, winner:null, goldAnnounced:new Set(), finalAnnounced:false};
  streaks.clear(); pending.clear(); feed=[]; banners=[]; particles=[];
}
resetRace();

/* ===================== Regras ===================== */
function goldActive(t){ return race.golds.some(g => t>=g && t<g+GOLD.len); }
function finalActive(t){ return t >= race.dur - FINAL.len && !race.overtime; }
function windowMult(){
  if(phase!=="run") return 1;
  if(finalActive(race.t) || race.overtime) return FINAL.mult;
  if(goldActive(race.t)) return GOLD.mult;
  return 1;
}
function gapFor(team){ // positivo = este time está atrás por X metros
  const me = race.runners[team], other = race.runners[team==="13"?"22":"13"];
  return other.dist - me.dist;
}
function underdogMult(team){
  const g = gapFor(team);
  if(g > 100) return 1.4;
  if(g > 30) return 1.2;
  return 1;
}
function rival(team){ return team==="13"?"22":"13"; }

function applyEffect(kind, senderTeam, count, uid, nick){
  if(phase!=="run") { return false; }
  const e = EFFECTS[kind];
  const target = e.self ? senderTeam : rival(senderTeam);
  const r = race.runners[target];
  const mult = windowMult() * underdogMult(senderTeam);
  const add = e.dur * count * mult;
  const cur = r.fx[kind];
  if(cur && cur.until > race.t) cur.until += add;
  else r.fx[kind] = {dv:e.dv, until:race.t + add};
  race.lastGifter[senderTeam] = {nick: nick||uid, t: race.t};
  const tag = count>1 ? " x"+count : "";
  pushFeed(`@${nick||uid}`, `${e.label}${tag}`, target, e.self);
  burst(target, e.self ? "boost" : "tired", kind==="simp"||kind==="scan");
  sfx(e.self ? "boost" : "tired");
  return true;
}

function commentBoost(team, uid){
  if(phase!=="run") return;
  const v = viewers.get(uid);
  if(v && race.t - (v.lastBoost ?? -99) < COMMENT.cooldown) return;
  if(v) v.lastBoost = race.t;
  const r = race.runners[team];
  r.comments.push(race.t + COMMENT.dur * windowMult());
}

function handleComment(uid, nick, text){
  const t = String(text||"").trim();
  const has13 = /(^|\D)13(\D|$)/.test(t), has22 = /(^|\D)22(\D|$)/.test(t);
  logLine(`comentário @${nick||uid}: ${t.slice(0,60)}`);
  if(has13 === has22) return; // nenhum ou os dois
  const team = has13 ? "13" : "22";
  let v = viewers.get(uid);
  const isNew = !v || v.team !== team;
  if(!v){ v = {team, nick, lastBoost:-99}; viewers.set(uid, v); }
  v.team = team; v.nick = nick || v.nick;
  if(isNew && phase==="run") pushFeed(`@${nick||uid}`, "entrou no time", team, true, true);
  commentBoost(team, uid);
  const p = pending.get(uid);
  if(p && phase==="run"){ pending.delete(uid); p.forEach(g => creditGift(g.kind, team, g.count, g.coins, uid, nick)); }
}

function kindForGift(name){
  const n = String(name||"").trim().toLowerCase();
  const match = key => String(cfg[key]||"").split(",").map(s=>s.trim().toLowerCase()).filter(Boolean).includes(n);
  if(match("g_imp")) return "imp";
  if(match("g_can")) return "can";
  if(match("g_simp")) return "simp";
  if(match("g_scan")) return "scan";
  return cfg.other ? "imp" : null;
}
function creditGift(kind, team, count, coins, uid, nick){
  const m = race.coins[team];
  m.set(nick||uid, (m.get(nick||uid)||0) + coins);
  applyEffect(kind, team, count, uid, nick);
}
function handleGift(uid, nick, name, delta, diamonds){
  logLine(`presente @${nick||uid}: ${name} x${delta} (${diamonds} moedas cada)`);
  const kind = kindForGift(name);
  if(!kind || delta<=0) return;
  const coins = (diamonds||1) * delta;
  const v = viewers.get(uid);
  if(!v){
    const list = pending.get(uid) || []; list.push({kind, count:delta, coins}); pending.set(uid, list);
    pushFeed(`@${nick||uid}`, "comente 13 ou 22 para valer", null, true, true);
    return;
  }
  creditGift(kind, v.team, delta, coins, uid, nick);
}

/* ===================== Simulação ===================== */
function update(dt){
  if(phase==="countdown"){
    const before = Math.ceil(countdownLeft);
    countdownLeft -= dt;
    const after = Math.ceil(countdownLeft);
    if(after !== before && after > 0) sfx("tick");
    if(countdownLeft <= 0){ phase="run"; sfx("go"); banner("VALENDO!", "#fff", 1.2); }
    return;
  }
  if(phase==="end"){
    if(cfg.auto && performance.now() >= nextRaceAt) startRace();
    return;
  }
  if(phase!=="run") return;

  race.t += dt;
  const t = race.t;
  for(const team of TEAMS){
    const r = race.runners[team];
    let target = BASE;
    for(const k in r.fx){ if(r.fx[k].until > t) target += r.fx[k].dv; else delete r.fx[k]; }
    r.comments = r.comments.filter(x => x > t);
    const cMult = (finalActive(t)||race.overtime) ? 2 : 1;
    target += Math.min(r.comments.length * COMMENT.dv * cMult, COMMENT.cap);
    const g = gapFor(team);
    if(g > 0.5) target += Math.min(6, Math.max(3, g/40));
    target = Math.max(VMIN, Math.min(VMAX, target));
    const step = ACCEL * dt;
    r.v += Math.max(-step, Math.min(step, target - r.v));
    r.dist += r.v / 3.6 * dt;
    r.phaseLeg += dt * (4 + r.v/6);
  }
  // liderança
  const d = race.runners["13"].dist - race.runners["22"].dist;
  let lead = race.leader;
  if(d > 1) lead = "13"; else if(d < -1) lead = "22";
  if(lead !== race.leader){
    if(race.leader !== null){
      race.changes++;
      const lg = race.lastGifter[lead];
      const who = lg && t - lg.t < 12 ? "@"+lg.nick : "a torcida";
      banner(`ULTRAPASSAGEM DO ${lead}!`, colorOf(lead), 2.2, `virada puxada por ${who}`);
      sfx("overtake");
    }
    race.leader = lead;
  }
  // parciais
  const min = Math.floor(t/60);
  if(min >= 1 && race.partials.length < min && t < race.dur){
    race.partials.push(race.leader || "-");
    banner(`${min}º MINUTO: ${race.leader ? race.leader+" NA FRENTE" : "EMPATE"}`, "#fff", 1.6);
  }
  // janelas
  race.golds.forEach((g,i) => { if(t>=g && !race.goldAnnounced.has(i)){ race.goldAnnounced.add(i); banner("JANELA DE OURO", "#ffc83d", 2, "efeitos valem 1,5x por 15 s"); sfx("gold"); } });
  if(finalActive(t) && !race.finalAnnounced){ race.finalAnnounced = true; banner("RETA FINAL", "#ffc83d", 2.2, "todos os efeitos valem o dobro"); sfx("gold"); }
  // fim
  if(t >= race.end){
    const gap = Math.abs(d);
    if(gap < TIE && !race.overtime){
      race.overtime = true; race.end = t + OVERTIME;
      banner("PRORROGAÇÃO!", "#ffc83d", 2.2, `diferença menor que ${TIE} m: mais ${OVERTIME} s`); sfx("gold");
    } else finishRace(d);
  }
}
function finishRace(d){
  phase = "end";
  race.winner = Math.abs(d) < 0.05 ? "EMPATE" : (d > 0 ? "13" : "22");
  nextRaceAt = performance.now() + Math.max(5, +cfg.gap || 15) * 1000;
  sfx("win");
}
function startRace(){
  resetRace();
  phase = "countdown"; countdownLeft = 3.99;
}

/* ===================== Efeitos visuais ===================== */
function pushFeed(who, what, team, good, info){
  feed.unshift({who, what, team, good, info, at: performance.now()});
  feed = feed.slice(0, 5);
}
function banner(text, color, life, sub){ banners = [{text, color, life, max:life, sub}]; }
function burst(team, type, big){
  const n = big ? 26 : 12;
  for(let i=0;i<n;i++) particles.push({team, type, x:0, y:0, vx:(Math.random()*-1-0.3)*(type==="boost"?260:120), vy:(Math.random()-0.5)*160, life:0.6+Math.random()*0.5, max:1.1});
}
function colorOf(team){ return team==="13" ? (cfg.col13||DEF.col13) : (cfg.col22||DEF.col22); }

/* ===================== Desenho ===================== */
const cv = document.getElementById("game");
const ctx = cv.getContext("2d");
let W=0, H=0, DPR=1;
function resize(){
  DPR = Math.min(2, window.devicePixelRatio||1);
  W = window.innerWidth; H = window.innerHeight;
  cv.width = Math.round(W*DPR); cv.height = Math.round(H*DPR);
  ctx.setTransform(DPR,0,0,DPR,0,0);
}
window.addEventListener("resize", resize); resize();

const F = (w,s) => `${w} ${s}px "Barlow Semi Condensed","Arial Narrow",Arial,sans-serif`;
const FD = s => `${s}px "Bungee","Impact","Arial Black",sans-serif`;
function rr(x,y,w,h,r){ ctx.beginPath(); ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r); ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath(); }
function fmtTime(s){ s=Math.max(0,Math.ceil(s)); return `${Math.floor(s/60)}:${String(s%60).padStart(2,"0")}`; }
function hexA(hex, a){ const h=hex.replace("#",""); const n=parseInt(h.length===3?h.split("").map(c=>c+c).join(""):h,16); return `rgba(${n>>16&255},${n>>8&255},${n&255},${a})`; }

function draw(now, fdt){
  const u = Math.min(W, H*0.75) / 100; // unidade de escala
  ctx.fillStyle = "#0b0d14"; ctx.fillRect(0,0,W,H);
  const portrait = H > W*1.15;

  // áreas
  const pad = Math.max(16, u*3);
  const topH = portrait ? H*0.2 : H*0.24;
  const trackY = topH + pad*0.5;
  const trackH = portrait ? H*0.4 : H*0.42;
  const laneH = trackH/2;
  const r13 = race.runners["13"], r22 = race.runners["22"];
  const mid = (r13.dist + r22.dist)/2;
  const gap = Math.abs(r13.dist - r22.dist);
  const ppm = Math.min(6, (W*0.3) / Math.max(1, gap/2)); // pixels por metro
  const cx = W*0.5;

  // pista
  ["13","22"].forEach((team, i) => {
    const y = trackY + i*laneH;
    const g = ctx.createLinearGradient(0,y,0,y+laneH);
    g.addColorStop(0, i? "#151a29":"#191e2f"); g.addColorStop(1, i? "#10131e":"#131726");
    ctx.fillStyle = g; ctx.fillRect(0,y,W,laneH);
    ctx.fillStyle = hexA(colorOf(team), .9); ctx.fillRect(0,y,6,laneH);
    ctx.font = FD(Math.max(14,laneH*0.16)); ctx.fillStyle = hexA(colorOf(team), .18);
    ctx.textAlign="left"; ctx.textBaseline="middle"; ctx.fillText(team, 16, y+laneH*0.5);
  });
  ctx.strokeStyle = "#2a3150"; ctx.lineWidth = 2; ctx.setLineDash([18,14]);
  ctx.beginPath(); ctx.moveTo(0,trackY+laneH); ctx.lineTo(W,trackY+laneH); ctx.stroke(); ctx.setLineDash([]);
  // marcas de distância
  const step = ppm > 2.5 ? 10 : ppm > 0.8 ? 50 : 100;
  const startM = Math.floor((mid - cx/ppm)/step)*step;
  ctx.font = F(600, Math.max(11,u*1.6)); ctx.textAlign="center"; ctx.textBaseline="top";
  for(let m=startM; m<mid + cx/ppm + step; m+=step){
    if(m<0) continue;
    const x = cx + (m-mid)*ppm;
    const major = m % (step*5) === 0;
    ctx.strokeStyle = major ? "#39415f" : "#232941"; ctx.lineWidth = major?2:1;
    ctx.beginPath(); ctx.moveTo(x,trackY); ctx.lineTo(x,trackY+trackH); ctx.stroke();
    if(major){ ctx.fillStyle="#5b6488"; ctx.fillText(`${m} m`, x, trackY+trackH+4); }
  }

  // corredores
  ["13","22"].forEach((team, i) => {
    const r = race.runners[team];
    const y = trackY + i*laneH + laneH*0.55;
    const x = cx + (r.dist - mid)*ppm;
    drawRunner(r, x, y, laneH*0.78, now);
  });

  // partículas
  const dt = fdt;
  particles = particles.filter(p => (p.life -= dt) > 0);
  particles.forEach(p => {
    const r = race.runners[p.team], i = p.team==="13"?0:1;
    const bx = cx + (r.dist-mid)*ppm, by = trackY + i*laneH + laneH*0.55;
    p.x += p.vx*dt; p.y += p.vy*dt;
    const a = p.life/p.max;
    ctx.fillStyle = p.type==="boost" ? `rgba(255,${150+Math.random()*80|0},40,${a})` : `rgba(120,190,255,${a})`;
    ctx.beginPath(); ctx.arc(bx + p.x - laneH*0.2, by + p.y, Math.max(2,laneH*0.03)*(0.5+a), 0, 7); ctx.fill();
  });

  drawTop(pad, topH, u, portrait);
  drawGapBar(pad, trackY + trackH + Math.max(26,u*4), u, gap);
  drawBottom(pad, trackY + trackH + Math.max(26,u*4) + Math.max(54,u*8), u);
  if((sprites["13"]&&sprites["13"].normal)||(sprites["22"]&&sprites["22"].normal)||imgs[13]||imgs[22]){ ctx.font = F(600, Math.max(10,u*1.4)); ctx.textAlign="right"; ctx.textBaseline="bottom"; ctx.fillStyle="#8b93ad"; ctx.fillText("Personagens gerados por IA", W - 10, trackY + trackH - 6); }
  drawBanners(u, fdt);
  if(phase==="countdown") drawCenterText(String(Math.ceil(countdownLeft)), u*22, "#fff");
  if(phase==="idle") drawIdle(u);
  if(phase==="end") drawWinner(u, now);
}

function drawRunner(r, x, y, size, now){
  const col = colorOf(r.team);
  const boosted = Object.keys(r.fx).some(k => EFFECTS[k].dv > 0);
  const tired = Object.keys(r.fx).some(k => EFFECTS[k].dv < 0);
  const bob = Math.abs(Math.sin(r.phaseLeg)) * size*0.06;
  // rastro de velocidade
  if(boosted){
    for(let k=0;k<5;k++){
      const ly = y - size*0.35 + k*size*0.15 + Math.sin(now/90+k)*3;
      const len = size*(0.5+Math.random()*0.6);
      const g = ctx.createLinearGradient(x-size*0.3-len,0,x-size*0.3,0);
      g.addColorStop(0,"rgba(255,180,40,0)"); g.addColorStop(1,"rgba(255,180,40,.75)");
      ctx.strokeStyle = g; ctx.lineWidth = Math.max(2,size*0.03);
      ctx.beginPath(); ctx.moveTo(x-size*0.3-len,ly); ctx.lineTo(x-size*0.3,ly); ctx.stroke();
    }
  }
  // sombra
  ctx.fillStyle = "rgba(0,0,0,.45)";
  ctx.beginPath(); ctx.ellipse(x, y+size*0.42, size*0.32, size*0.06, 0, 0, 7); ctx.fill();

  const im = imgs[r.team];
  const sp = sprites[r.team];
  const useSp = !!(sp && sp.normal && !im);
  ctx.save(); ctx.translate(x, y - (useSp ? 0 : bob));
  if(tired && !useSp) ctx.globalAlpha = 0.85;
  if(sp && !im && sp.normal){
    const net = Object.values(r.fx).reduce((a,e)=>a+e.dv,0);
    const st = (net > 0 && sp.turbo) ? sp.turbo : (net < 0 && sp.tired) ? sp.tired : sp.normal;
    const h = (size*1.02) / st.bodyH, w = h * st.fw/st.fh;
    const f = Math.floor(((r.phaseLeg/(Math.PI*2)) * st.frames) % st.frames + st.frames) % st.frames;
    ctx.imageSmoothingEnabled = false;
    ctx.drawImage(st.im, f*st.fw, 0, st.fw, st.fh, -st.ax*w, size*0.42 - st.ay*h, w, h);
  } else if(im){
    const s = size; const ar = im.width/im.height;
    const w = ar>=1 ? s : s*ar, h = ar>=1 ? s/ar : s;
    ctx.rotate(Math.sin(r.phaseLeg)*0.05 + (boosted?-0.08:0));
    ctx.drawImage(im, -w/2, -h/2 - size*0.05, w, h);
  } else {
    // personagem padrão: corpo arredondado com número e pernas
    const s = size;
    const leg = Math.sin(r.phaseLeg);
    ctx.strokeStyle = "#0b0d14"; ctx.lineCap="round"; ctx.lineWidth = s*0.09;
    const hip = s*0.12;
    [[leg,1],[-leg,0.65]].forEach(([a,alpha]) => {
      ctx.globalAlpha = alpha * (tired?0.85:1);
      ctx.strokeStyle = alpha<1 ? "#05060a" : "#1d2133";
      ctx.beginPath(); ctx.moveTo(0,hip);
      const kx = a*s*0.16, ky = hip + s*0.16;
      ctx.lineTo(kx, ky); ctx.lineTo(kx - Math.max(0,-a)*s*0.1 + a*s*0.06, ky + s*0.14); ctx.stroke();
    });
    ctx.globalAlpha = tired?0.85:1;
    // braços
    ctx.lineWidth = s*0.07; ctx.strokeStyle = "#1d2133";
    ctx.beginPath(); ctx.moveTo(-s*0.05,-s*0.05); ctx.lineTo(-s*0.05 - leg*s*0.16, s*0.08); ctx.stroke();
    // corpo
    const g = ctx.createLinearGradient(0,-s*0.35,0,s*0.2);
    g.addColorStop(0, col); g.addColorStop(1, hexA(col,.75));
    ctx.fillStyle = g; rr(-s*0.22,-s*0.36,s*0.44,s*0.52,s*0.2); ctx.fill();
    ctx.lineWidth = s*0.025; ctx.strokeStyle="rgba(255,255,255,.35)"; ctx.stroke();
    // faixa
    ctx.fillStyle="rgba(255,255,255,.92)"; rr(-s*0.16,-s*0.2,s*0.32,s*0.2,s*0.05); ctx.fill();
    ctx.fillStyle="#0b0d14"; ctx.font = FD(s*0.15); ctx.textAlign="center"; ctx.textBaseline="middle";
    ctx.fillText(r.team, 0, -s*0.1);
    // olho e faixa de cabeça
    ctx.fillStyle="#fff"; ctx.beginPath(); ctx.arc(s*0.1,-s*0.27,s*0.045,0,7); ctx.fill();
    ctx.fillStyle="#0b0d14"; ctx.beginPath(); ctx.arc(s*0.115,-s*0.27,s*0.022,0,7); ctx.fill();
    ctx.fillStyle="rgba(255,255,255,.85)"; ctx.fillRect(-s*0.22,-s*0.33,s*0.44,s*0.03);
  }
  ctx.restore();
  // cansaço: gotas
  if(tired){
    ctx.fillStyle = "rgba(130,200,255,.9)";
    for(let k=0;k<3;k++){
      const t = ((now/600 + k/3) % 1);
      ctx.beginPath(); ctx.arc(x + size*0.25 + k*6, y - size*0.45 + t*size*0.3, Math.max(2,size*0.025), 0, 7); ctx.fill();
    }
  }
  // velocidade sobre o personagem
  ctx.font = F(800, Math.max(13,size*0.13)); ctx.textAlign="center"; ctx.textBaseline="bottom";
  ctx.fillStyle = boosted ? "#ffc83d" : tired ? "#82c8ff" : "#eef1fa";
  const labelY = (sprites[r.team] && sprites[r.team].normal && !imgs[r.team]) ? y + size*0.42 - size*1.02 - 2 : y - size*0.5;
  ctx.fillText(`${Math.round(r.v)} km/h`, x, labelY);
}

function drawTop(pad, topH, u, portrait){
  const t = race ? race.t : 0;
  const left = phase==="run" ? race.end - t : race.dur;
  const y0 = Math.max(pad, 10) + (parseFloat(getComputedStyle(document.documentElement).paddingTop)||0);
  // relógio
  ctx.textAlign="center"; ctx.textBaseline="top";
  const mult = windowMult();
  ctx.font = FD(Math.max(28,u*7)); ctx.fillStyle = mult>1 ? "#ffc83d" : "#eef1fa";
  ctx.fillText(fmtTime(left), W/2, y0);
  const clockH = Math.max(28,u*7);
  ctx.font = F(700, Math.max(12,u*1.8)); ctx.fillStyle = "#8b93ad";
  const tag = race.overtime ? "PRORROGAÇÃO" : (finalActive(t) && phase==="run") ? "RETA FINAL  ·  EFEITOS 2x" : (goldActive(t) && phase==="run") ? "JANELA DE OURO  ·  EFEITOS 1,5x" : `TROCAS DE LIDERANÇA: ${race.changes}`;
  if(mult>1) ctx.fillStyle="#ffc83d";
  ctx.fillText(tag, W/2, y0 + clockH*1.08);

  // placas dos times
  const cardW = Math.min(W*0.3, u*30), cardH = Math.max(72, topH*0.72);
  ["13","22"].forEach((team, i) => {
    const r = race.runners[team];
    const x = i ? W - pad - cardW : pad;
    ctx.fillStyle = "#141826"; rr(x, y0, cardW, cardH, 12); ctx.fill();
    ctx.strokeStyle = hexA(colorOf(team), race.leader===team ? 1 : .35); ctx.lineWidth = race.leader===team?3:1.5; ctx.stroke();
    ctx.textAlign = i ? "right" : "left"; ctx.textBaseline="top";
    const tx = i ? x+cardW-12 : x+12;
    ctx.font = FD(Math.max(20,cardH*0.34)); ctx.fillStyle = colorOf(team);
    ctx.fillText(team, tx, y0+8);
    const fsz = Math.max(13, Math.min(cardH*0.18, cardW*0.11));
    ctx.font = F(800, fsz); ctx.fillStyle="#eef1fa";
    ctx.fillText(`${Math.round(r.dist)} m`, tx, y0 + 8 + cardH*0.36, cardW-24);
    ctx.font = F(700, fsz*0.85); ctx.fillStyle="#b9c0d6";
    ctx.fillText(`${Math.round(r.v)} km/h`, tx, y0 + 8 + cardH*0.36 + fsz*1.1, cardW-24);
    // MVP
    let mvp = null, best = 0; race.coins[team].forEach((c,n) => { if(c>best){best=c; mvp=n;} });
    ctx.font = F(700, Math.max(11, Math.min(cardH*0.13, cardW*0.075))); ctx.fillStyle="#8b93ad";
    const ud = underdogMult(team);
    const line = phase==="run" && ud>1 ? `PRESENTES VALEM +${Math.round((ud-1)*100)}%` : mvp ? `MVP @${mvp.slice(0,14)}` : "MVP: ninguém ainda";
    if(phase==="run" && ud>1) ctx.fillStyle = "#ffc83d";
    ctx.fillText(line, tx, y0 + cardH - 8 - Math.max(11, Math.min(cardH*0.13, cardW*0.075)), cardW-24);
  });

  // parciais
  if(race.partials.length){
    ctx.font = F(700, Math.max(11,u*1.6)); ctx.textBaseline="top"; ctx.textAlign="center";
    const s = race.partials.map((p,i)=>`${i+1}º min: ${p}`).join("   ");
    ctx.fillStyle="#8b93ad"; ctx.fillText(s, W/2, y0 + cardH + 8, W - pad*2);
  }
}

function drawGapBar(pad, y, u, gap){
  const w = W - pad*2, h = Math.max(18, u*3), x = pad;
  ctx.fillStyle = "#141826"; rr(x, y, w, h, h/2); ctx.fill();
  const d = race.runners["13"].dist - race.runners["22"].dist;
  const frac = Math.min(1, Math.abs(d)/300);
  const half = w/2;
  if(Math.abs(d) > 0.3){
    const lead = d>0 ? "13" : "22";
    ctx.fillStyle = colorOf(lead);
    const bw = half*frac;
    if(lead==="13") { rr(x+half-bw, y, bw, h, h/2); } else { rr(x+half, y, bw, h, h/2); }
    ctx.fill();
  }
  ctx.fillStyle="#eef1fa"; ctx.fillRect(x+half-1.5, y-4, 3, h+8);
  ctx.font = F(800, Math.max(13,u*2)); ctx.textBaseline="top"; ctx.textAlign="center"; ctx.fillStyle="#eef1fa";
  const txt = Math.abs(d) < 1 ? "LADO A LADO" : `${d>0?"13":"22"} LIDERA POR ${Math.round(Math.abs(d))} m`;
  ctx.fillText(txt, W/2, y + h + 6);
  ctx.font = F(700, Math.max(11,u*1.6)); ctx.fillStyle="#8b93ad";
  ctx.textAlign="left"; ctx.fillText("◀ 13", x, y + h + 6);
  ctx.textAlign="right"; ctx.fillText("22 ▶", x+w, y + h + 6);
}

function drawBottom(pad, y, u){
  // feed
  const fs = Math.max(13, u*2.1);
  ctx.textBaseline="top"; ctx.textAlign="left";
  const nowMs = performance.now();
  feed.forEach((f, i) => {
    const age = (nowMs - f.at)/1000;
    if(age > 8) return;
    const a = Math.max(0, 1 - Math.max(0, age-6)/2);
    const yy = y + i*(fs*1.55);
    if(yy + fs > H - pad - fs*3) return;
    ctx.globalAlpha = a;
    ctx.font = F(800, fs); ctx.fillStyle = "#eef1fa";
    const who = f.who.length>18 ? f.who.slice(0,18)+"…" : f.who;
    ctx.fillText(who, pad, yy);
    const ww = ctx.measureText(who + "  ").width;
    ctx.fillStyle = f.info ? "#8b93ad" : (f.good ? "#ffc83d" : "#82c8ff");
    ctx.fillText(f.what, pad + ww, yy);
    if(f.team){
      const w2 = ctx.measureText(f.what + "  ").width;
      ctx.fillStyle = colorOf(f.team); ctx.font = FD(fs*0.9);
      ctx.fillText((f.info?"":"→ ") + f.team, pad + ww + w2, yy);
    }
    ctx.globalAlpha = 1;
  });
  // instruções
  const ih = fs*2.7;
  const iy = H - pad - ih - (parseFloat(getComputedStyle(document.documentElement).paddingBottom)||0);
  ctx.fillStyle = "#141826"; rr(pad, iy, W-pad*2, ih, 10); ctx.fill();
  ctx.textAlign="center"; ctx.textBaseline="middle";
  ctx.font = F(800, fs); ctx.fillStyle="#eef1fa";
  ctx.fillText("COMENTE 13 OU 22 PARA ENTRAR NO TIME  ·  CADA COMENTÁRIO ACELERA", W/2, iy + ih*0.32, W-pad*2-16);
  ctx.font = F(600, fs*0.85); ctx.fillStyle="#8b93ad";
  const nm = k => String(cfg[k]||"").split(",")[0].trim() || "-";
  ctx.fillText(`${nm("g_imp")}: impulso  ·  ${nm("g_can")}: cansaço no rival  ·  ${nm("g_simp")}: super impulso  ·  ${nm("g_scan")}: super cansaço`, W/2, iy + ih*0.7, W-pad*2-16);
}

function drawBanners(u, fdt){
  banners = banners.filter(b => (b.life -= fdt) > 0);
  banners.forEach((b, i) => {
    const p = 1 - b.life/b.max;
    const scale = p < 0.12 ? 0.6 + p/0.12*0.4 : 1;
    const a = b.life < 0.4 ? b.life/0.4 : 1;
    const y = H*0.72;
    ctx.save(); ctx.globalAlpha = a; ctx.translate(W/2, y); ctx.scale(scale, scale);
    const fs = Math.max(26, u*7);
    ctx.font = FD(fs);
    const tw = Math.min(W*0.92, ctx.measureText(b.text).width + fs);
    ctx.fillStyle = "rgba(11,13,20,.82)"; rr(-tw/2, -fs*0.85, tw, fs*(b.sub?2.2:1.7), 14); ctx.fill();
    ctx.textAlign="center"; ctx.textBaseline="middle"; ctx.fillStyle = b.color;
    ctx.fillText(b.text, 0, 0, W*0.88);
    if(b.sub){ ctx.font = F(700, fs*0.42); ctx.fillStyle="#eef1fa"; ctx.fillText(b.sub, 0, fs*0.85, W*0.85); }
    ctx.restore();
  });
}
function drawCenterText(t, size, color){
